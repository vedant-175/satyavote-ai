# Supabase PostgreSQL
DATABASE_URL="your-supabase-session-pooler-connection"
DIRECT_URL="your-supabase-direct-or-session-pooler-connection"

# NextAuth / Auth.js
AUTH_SECRET="replace-with-a-secure-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider
AI_PROVIDER=gemini
ANTHROPIC_API_KEY=""
