# ==============================================================================
# AI-Assisted Election Information Verification Platform
# Environment Configuration Template (.env.example)
# ==============================================================================

# Database Connection (PostgreSQL + pgvector)
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/election_verification?schema=public"

# NextAuth / Auth.js Configuration
AUTH_SECRET="replace-with-a-secure-random-32-byte-hex-string-for-production"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider: 'claude' | 'gemini'
AI_PROVIDER=gemini
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Fact Checking & Search Providers
GOOGLE_FACTCHECK_API_KEY=""
SEARCH_PROVIDER=tavily        # tavily | brave | serpapi
SEARCH_API_KEY=""
REVERSE_IMAGE_API_KEY=""
AI_IMAGE_DETECT_API_KEY=""    # optional

# Storage & Inngest / Job Queue
STORAGE_URL=""
STORAGE_KEY=""
INNGEST_EVENT_KEY=""

# Run with offline mocked responses for demo & tests (no paid keys needed)
USE_MOCKS=true
