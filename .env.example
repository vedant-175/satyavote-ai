# Fact Checking & Search
GOOGLE_FACTCHECK_API_KEY=""
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=""
REVERSE_IMAGE_API_KEY=""
AI_IMAGE_DETECT_API_KEY=""

# Storage & Job Queue
STORAGE_URL=""
STORAGE_KEY=""
INNGEST_EVENT_KEY=""

# Development
USE_MOCKS=true